---
// Shell for the live demo hand. demo.ts draws the art and the sleeve into the SVG for the chosen
// design, colour, size and mood, in the same 100-unit space the app uses (see scripts/skins.ts).
---

<div class="hand" aria-hidden="true">
  <div class="hand-body">
    <svg class="hand-art" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" data-hand-art></svg>
  </div>
</div>
