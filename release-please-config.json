{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "manita",
      "include-component-in-tag": false,
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "xml", "path": "Resources/Info.plist", "xpath": "//dict/key[text()='CFBundleShortVersionString']/following-sibling::string[1]" },
        { "type": "generic", "path": "packaging/homebrew/manita.rb" }
      ]
    }
  }
}
